# API Configuration
# The backend API base URL (default proxies through Next.js)
NEXT_PUBLIC_API_URL=/api

# Optional: where /bc/uploads/* is proxied in production (default https://bareefers.org)
# NEXT_PUBLIC_UPLOADS_ORIGIN=https://bareefers.org

# Optional: legacy Barcode Nuxt host (add-tank, equipment flows). Defaults: dev → http://localhost:8080, prod → https://barcode.bareefers.org
# NEXT_PUBLIC_LEGACY_BARCODE_ORIGIN=https://barcode.bareefers.org

# For production, you might want to point directly to the API:
# NEXT_PUBLIC_API_URL=https://api.bareefers.org/api
